From b388cb0045400e35b661df70fbb37a11a4eb739b Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Thu, 22 Oct 2026 00:13:24 -0400
Subject: [PATCH] loader: take the extra driver dir length at run time

L0_LOADER_EXTRA_DRIVER_DIR is a string literal, so the compiler folds the
std::string length to the literal's size. Packagers such as conda relocate
the prefix by rewriting the string in the binary and padding it with NULs;
with the folded length those NULs stay inside the path, and dlopen() of the
discovered full path then fails with "Is a directory". Read the literal
through a volatile pointer so strlen() runs at run time.
---
 source/loader/linux/driver_discovery_lin.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/source/loader/linux/driver_discovery_lin.cpp b/source/loader/linux/driver_discovery_lin.cpp
index c9916e7..1b69e23 100644
--- a/source/loader/linux/driver_discovery_lin.cpp
+++ b/source/loader/linux/driver_discovery_lin.cpp
@@ -53,7 +53,13 @@ static std::vector<std::string> getLibrarySearchPaths() {
   // -- but before the system locations.  This lets a driver co-installed in the
   // same prefix (e.g. a conda environment) be discovered by default, without
   // having to set ZE_ENABLE_ALT_DRIVERS.
-  paths.push_back(L0_LOADER_EXTRA_DRIVER_DIR);
+  {
+    // Packagers may relocate this path by rewriting the string in the binary
+    // and padding it with NULs (conda does).  Read it through a volatile
+    // pointer so its length is taken at run time, not from the literal.
+    static const char *volatile extraDriverDir = L0_LOADER_EXTRA_DRIVER_DIR;
+    paths.push_back(std::string(extraDriverDir));
+  }
 #endif
 #if defined(ANDROID)
   paths.push_back("/vendor/lib64");
-- 
